# TLS is terminated by Traefik (Dokploy), so Caddy only speaks plain HTTP.
{
	auto_https off
	admin off
	frankenphp
	servers {
		trusted_proxies static private_ranges
	}
}

{$SERVER_NAME::8080} {
	root * /app/public
	encode zstd br gzip

	log {
		output stderr
		format console
		level WARN
	}

	# Encrypted HLS segments (ADR-0004): static, no per-segment auth.
	# Playlists and AES keys live on the private disk and go through Laravel.
	@hls path /hls/*
	header @hls Cache-Control "public, max-age=31536000, immutable"

	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	php_server
}
