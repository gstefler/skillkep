# Variables set in Dokploy (skillkep › production › app › Environment).
# Secrets are only in Dokploy, never in the repo.
IMAGE_TAG=latest
APP_NAME="Skill K.E.P"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://v2.skillkep.eu
APP_LOCALE=hu
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=hu_HU
LOG_CHANNEL=stderr
LOG_LEVEL=info
DB_CONNECTION=pgsql
DB_HOST=skillkep-db-riwejd
DB_PORT=5432
DB_DATABASE=skillkep
DB_USERNAME=skillkep
DB_PASSWORD=
REDIS_CLIENT=phpredis
REDIS_HOST=skillkep-redis-nkyvkv
REDIS_PORT=6379
REDIS_PASSWORD=
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local
MAIL_MAILER=smtp
MAIL_HOST=skillkep-mailpit-9truvi
MAIL_PORT=1025
MAIL_FROM_ADDRESS=noreply@skillkep.eu
MAIL_FROM_NAME="${APP_NAME}"
